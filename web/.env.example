# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=            # pooled Neon URL (app traffic)
DATABASE_URL_UNPOOLED=   # direct Neon URL (migrations)
ADMIN_USERNAME=
ADMIN_PASSWORD=
BRIDGE_API_KEY=          # long random string, same value in the bridge config
SESSION_SECRET=          # 32+ random bytes, hex
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Manila
NEXT_PUBLIC_BRIDGE_URL=http://localhost:5055   # where the browser finds the bridge
MEMBERSHIP_PRICE=800     # fixed monthly fee in pesos
